# Copy file này thành .env rồi điền giá trị thật. KHÔNG chia sẻ file .env cho ai.

# Token của Fanpage (lấy trong Meta App Dashboard -> Messenger -> Access Tokens)
# Chế độ 1 Page: điền token vào đây là xong.
PAGE_ACCESS_TOKEN=

# Chế độ NHIỀU Page (chung 1 menu): liệt kê token từng Page theo ID,
# dạng JSON: {"id_page_1":"token_1","id_page_2":"token_2"}
# Lấy ID Page: vào Fanpage -> Cài đặt -> Thông tin Trang -> ID Trang.
# Khi đã điền PAGE_TOKENS thì Page nào chưa có trong danh sách sẽ KHÔNG được trả lời.
PAGE_TOKENS=

# App Secret của Meta App (App Dashboard -> App settings -> Basic)
APP_SECRET=

# Chuỗi tự đặt để Meta xác minh webhook (đặt gì cũng được, nhớ dùng đúng khi cấu hình)
VERIFY_TOKEN=dat_chuoi_bi_mat_cua_ban

# API key Google Gemini (lấy miễn phí tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Model AI (mặc định gemini-2.0-flash: nhanh, rẻ)
GEMINI_MODEL=gemini-2.0-flash

# Tên shop hiển thị trong câu trả lời của bot
SHOP_NAME=Tên Shop Của Bạn

# Link công cụ chốt đơn (bot sẽ gửi cho khách khi khách muốn đặt món)
ORDER_TOOL_URL=

# Render/Railway tự đặt PORT, không cần sửa
PORT=3000
